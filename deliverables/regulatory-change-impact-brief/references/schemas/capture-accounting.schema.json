{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "required_source_ids",
    "scope_comparison",
    "raw_tables",
    "technical_diagnostics",
    "boundary"
  ],
  "properties": {
    "required_source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 10,
      "maxItems": 10
    },
    "scope_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_ids",
        "current_ids",
        "missing_ids",
        "additional_ids",
        "result"
      ],
      "properties": {
        "requested_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "current_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "additional_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "enum": [
            "matched",
            "different",
            "unverified"
          ]
        }
      }
    },
    "raw_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "sheet_id",
          "tab_title",
          "rows",
          "source_basis"
        ],
        "properties": {
          "source_id": {
            "enum": [
              "SYSTEMS",
              "EVIDENCE",
              "CALENDAR"
            ]
          },
          "sheet_id": {
            "type": "integer"
          },
          "tab_title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "source_basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "technical_diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "boundary": {
      "const": "U07 core capture only; linked reports and interpretation require a subsequent U08 run"
    }
  }
}
