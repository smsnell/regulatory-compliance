{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system_ids", "basis_version", "authorized_by", "source_basis"],
  "properties": {
    "schema_version": {"const": "rci-scope-input/1"},
    "system_ids": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "basis_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "authorized_by": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "source_basis": {"type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
  }
}
