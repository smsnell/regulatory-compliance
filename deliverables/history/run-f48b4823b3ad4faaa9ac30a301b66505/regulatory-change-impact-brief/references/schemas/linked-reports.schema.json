{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reports"
  ],
  "properties": {
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_business_id",
          "system_id",
          "owner",
          "reference",
          "locator",
          "authorized",
          "attempt_ids",
          "capture_ids",
          "evidence_ids",
          "result"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_business_id": {
            "type": "string",
            "minLength": 1
          },
          "system_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "locator": {
            "type": [
              "object",
              "null"
            ]
          },
          "authorized": {
            "type": "boolean"
          },
          "attempt_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "capture_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "result": {
            "enum": [
              "unresolved",
              "captured-unverified"
            ]
          }
        }
      }
    }
  }
}
