{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rci:u06:normalized-values:1",
  "$ref": "#/$defs/normalized-values",
  "$defs": {
    "SYSTEMS": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "system_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "use_case": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider_role": {
          "enum": [
            true,
            false,
            null
          ]
        },
        "deployer_role": {
          "enum": [
            true,
            false,
            null
          ]
        },
        "exposed_group": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "output_type": {
          "enum": [
            "direct_interaction",
            "text",
            "synthetic_image",
            "classification",
            "synthetic_audio_video"
          ]
        },
        "current_notice": {
          "enum": [
            "yes",
            "no",
            "unknown",
            "visible_label",
            "not_applicable"
          ]
        },
        "human_review": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_state": {
          "enum": [
            "complete",
            "partial",
            "conflicting",
            "missing",
            "stale"
          ]
        },
        "evidence_updated_on": {
          "type": "string",
          "format": "date"
        },
        "record_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "SYSTEMS-complete": {
      "allOf": [
        {
          "$ref": "#/$defs/SYSTEMS"
        },
        {
          "required": [
            "system_id",
            "system_name",
            "use_case",
            "owner",
            "provider_role",
            "deployer_role",
            "exposed_group",
            "output_type",
            "current_notice",
            "human_review",
            "evidence_state",
            "evidence_updated_on",
            "record_version"
          ]
        }
      ]
    },
    "EVIDENCE": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "system_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_record_type": {
          "enum": [
            "evidence",
            "evidence_gap",
            "incident",
            "exception_request"
          ]
        },
        "reported_on": {
          "type": "string",
          "format": "date"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "operational_status": {
          "enum": [
            "open",
            "closed",
            "draft"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_state": {
          "enum": [
            "complete",
            "partial",
            "conflicting",
            "missing",
            "stale"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "EVIDENCE-complete": {
      "allOf": [
        {
          "$ref": "#/$defs/EVIDENCE"
        },
        {
          "required": [
            "record_id",
            "system_id",
            "source_record_type",
            "reported_on",
            "owner",
            "operational_status",
            "evidence_ref",
            "evidence_state",
            "notes"
          ]
        }
      ]
    },
    "CALENDAR": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "system_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "existing_due_date": {
          "type": "string",
          "format": "date"
        },
        "operational_status": {
          "enum": [
            "planned",
            "open",
            "blocked",
            "scheduled",
            "closed"
          ]
        },
        "required_reviewer": {
          "enum": [
            "Legal",
            "Operations"
          ]
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "CALENDAR-complete": {
      "allOf": [
        {
          "$ref": "#/$defs/CALENDAR"
        },
        {
          "required": [
            "action_id",
            "system_id",
            "action",
            "owner",
            "existing_due_date",
            "operational_status",
            "required_reviewer",
            "source_version"
          ]
        }
      ]
    },
    "normalized-values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "register",
        "raw",
        "fields",
        "field_locators",
        "validation_status"
      ],
      "properties": {
        "schema_version": {
          "const": "rci-normalized-values/1"
        },
        "register": {
          "enum": [
            "SYSTEMS",
            "EVIDENCE",
            "CALENDAR"
          ]
        },
        "raw": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headers",
            "cells"
          ],
          "properties": {
            "headers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "cells": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null",
                  "object",
                  "array"
                ]
              }
            }
          }
        },
        "fields": {
          "type": "object"
        },
        "field_locators": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "sheet"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "validation_status": {
          "enum": [
            "valid",
            "unresolved"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "register": {
                "const": "SYSTEMS"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "$ref": "#/$defs/SYSTEMS"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "validation_status": {
                      "const": "valid"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "fields": {
                      "$ref": "#/$defs/SYSTEMS-complete"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "register": {
                "const": "EVIDENCE"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "$ref": "#/$defs/EVIDENCE"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "validation_status": {
                      "const": "valid"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "fields": {
                      "$ref": "#/$defs/EVIDENCE-complete"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "register": {
                "const": "CALENDAR"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "$ref": "#/$defs/CALENDAR"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "validation_status": {
                      "const": "valid"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "fields": {
                      "$ref": "#/$defs/CALENDAR-complete"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "validation_status": {
                "const": "valid"
              }
            }
          },
          "then": {
            "properties": {
              "raw": {
                "properties": {
                  "cells": {
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
