{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rci-u10-reconciliation/1"
    },
    "draft_only": {
      "const": true
    },
    "assigned_review_date": {
      "const": "2026-08-26"
    },
    "interpretation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            }
          },
          "required": [
            "request",
            "response"
          ]
        }
      ]
    },
    "candidate_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "candidate": {},
          "disposition": {
            "enum": [
              "accepted-draft-assertion",
              "unresolved"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "number",
          "candidate",
          "disposition",
          "reason"
        ]
      }
    },
    "register_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "enum": [
              "SYSTEMS",
              "EVIDENCE",
              "CALENDAR"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "raw_cells": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "normalized_row_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "output_record_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "disposition": {
            "enum": [
              "retained",
              "unresolved"
            ]
          }
        },
        "required": [
          "source_id",
          "locator",
          "raw_cells",
          "normalized_row_ids",
          "output_record_ids",
          "disposition"
        ]
      }
    },
    "register_tables": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "normalized_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_row_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "output_record_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          }
        },
        "required": [
          "source_row_id",
          "output_record_ids"
        ]
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "report": {
            "type": "object"
          },
          "candidate_numbers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "gap_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "report",
          "candidate_numbers",
          "gap_id"
        ]
      }
    },
    "calendar_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_row_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_business_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "system_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "fields": {
            "type": "object"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "locator": {
            "type": "object"
          },
          "approval_status": {
            "const": "pending"
          },
          "completion_status": {
            "const": "unresolved"
          },
          "scope_expansion": {
            "type": "null"
          }
        },
        "required": [
          "source_row_id",
          "source_business_id",
          "system_id",
          "fields",
          "evidence_ids",
          "locator",
          "approval_status",
          "completion_status",
          "scope_expansion"
        ]
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "system_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "registers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "SYSTEMS": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "EVIDENCE": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "CALENDAR": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "SYSTEMS",
              "EVIDENCE",
              "CALENDAR"
            ]
          },
          "owner_candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "all_calendar_rows": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "system_id",
          "registers",
          "owner_candidates",
          "all_calendar_rows"
        ]
      }
    },
    "fact_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "system_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "predicate": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "record_id",
          "system_id",
          "predicate",
          "scope"
        ]
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "system_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "predicate": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "related_system_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "record_id",
          "system_id",
          "predicate",
          "scope"
        ]
      }
    },
    "policy_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "const": "POLICY"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "candidate_numbers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "source_id",
          "evidence_ids",
          "candidate_numbers"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "draft_only",
    "assigned_review_date",
    "interpretation",
    "candidate_reviews",
    "register_rows",
    "register_tables",
    "normalized_rows",
    "reports",
    "calendar_context",
    "systems",
    "fact_groups",
    "issues",
    "policy_context"
  ]
}
